// Cloudflare Workers hosting for the XS Connect web app (static files only).
// Cloudflare builds this from GitHub on every push to main:
//   build command:  npm run build
//   deploy command: npx wrangler deploy
// The database and server functions stay on Supabase.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xs-connect",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    // App screens are client-side routes: unknown paths get the app shell with 200.
    "not_found_handling": "single-page-application",
    // /privacy serves privacy/index.html directly, without a redirect.
    "html_handling": "drop-trailing-slash"
  },
  // Custom domains on the xelorsoft.com zone (DNS on Cloudflare).
  "routes": [
    { "pattern": "app.xelorsoft.com", "custom_domain": true },
    { "pattern": "xelorsoft.com", "custom_domain": true },
    { "pattern": "www.xelorsoft.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
